package com.bootexample4.products.controller;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import org.springframework.http.ResponseEntity;
import com.bootexample4.products.model.Product;
import com.bootexample4.products.repository.ProductRepository;
import java.util.Optional;
import static org.mockito.Mockito.*;
import static org.assertj.core.api.Assertions.assertThat;
import org.junit.jupiter.api.*;
import java.util.List;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.*;

@ExtendWith(MockitoExtension.class)
public class ProductControllerUpdateProductTest {
    @Mock
    private ProductRepository productRepository;
    @InjectMocks
    private ProductController productController;
    // Existing product mock for testing
    private Product existingProduct;
    @BeforeEach
    public void setup() {
        // Initialize existing product mock object
        existingProduct = new Product();
        existingProduct.setId(1L);
        existingProduct.setName("Original Product Name");
        existingProduct.setDescription("Original Product Description");
        existingProduct.setPrice(100.0);
    }
    @Test
    @Tag("valid")
    public void updateProductSuccessfully() {
        // Arrange
        Long productId = 1L;
        Product updatedInfo = new Product();
        updatedInfo.setName("Updated Product Name");
        updatedInfo.setDescription("Updated Product Description");
        updatedInfo.setPrice(150.0);
        when(productRepository.findById(productId)).thenReturn(Optional.of(existingProduct));
        when(productRepository.save(existingProduct)).thenReturn(existingProduct);
        // Act
        ResponseEntity<Product> response = productController.updateProduct(productId, updatedInfo);
        // Assert
        verify(productRepository).findById(productId);
        verify(productRepository).save(existingProduct);
        assertThat(response.getStatusCodeValue()).isEqualTo(200);
        assertThat(response.getBody().getName()).isEqualTo(updatedInfo.getName());
        assertThat(response.getBody().getDescription()).isEqualTo(updatedInfo.getDescription());
        assertThat(response.getBody().getPrice()).isEqualTo(updatedInfo.getPrice());
    }
    @Test
    @Tag("invalid")
    public void updateProductWithNonExistentId() {
        // Arrange
        Long productId = 99L; // Non-existent product ID
        Product updatedInfo = new Product();
        updatedInfo.setName("Updated Product Name");
        updatedInfo.setDescription("Updated Product Description");
        updatedInfo.setPrice(150.0);
        when(productRepository.findById(productId)).thenReturn(Optional.empty());
        // Act
        ResponseEntity<Product> response = productController.updateProduct(productId, updatedInfo);
        // Assert
        verify(productRepository).findById(productId);
        verify(productRepository, never()).save(any(Product.class));
        assertThat(response.getStatusCodeValue()).isEqualTo(404);
    }
    @Test
    @Tag("boundary")
    public void updateProductWithEmptyName() {
        // Arrange
        Long productId = 1L;
        Product updatedInfo = new Product();
        updatedInfo.setName(""); // Boundary case: Empty name
        updatedInfo.setDescription("Updated Description for Boundary Case");
        updatedInfo.setPrice(150.0);
        when(productRepository.findById(productId)).thenReturn(Optional.of(existingProduct));
        when(productRepository.save(existingProduct)).thenReturn(existingProduct);
        // Act
        ResponseEntity<Product> response = productController.updateProduct(productId, updatedInfo);
        // Assert
        verify(productRepository).findById(productId);
        assertThat(response.getBody().getName()).isEqualTo(updatedInfo.getName());
        verify(productRepository).save(existingProduct);
        assertThat(response.getStatusCodeValue()).isEqualTo(200);
    }
    @Test
    @Tag("invalid")
    public void updateProductWithNullValues() {
        // Arrange
        Long productId = 1L;
        Product updatedInfo = new Product();
        updatedInfo.setName(null); // Invalid test case: Null values
        updatedInfo.setDescription(null);
        updatedInfo.setPrice(null);
        when(productRepository.findById(productId)).thenReturn(Optional.of(existingProduct));
        when(productRepository.save(existingProduct)).thenReturn(existingProduct);
        // Act
        ResponseEntity<Product> response = productController.updateProduct(productId, updatedInfo);
        // Assert
        verify(productRepository).findById(productId);
        assertThat(response.getBody().getName()).isNull();
        assertThat(response.getBody().getDescription()).isNull();
        assertThat(response.getBody().getPrice()).isNull();
        verify(productRepository).save(existingProduct);
        assertThat(response.getStatusCodeValue()).isEqualTo(200);
    }
}