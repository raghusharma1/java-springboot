    public void verifySuccessfulProductCreation() {
        // Arrange
        Product product = new Product();
        product.setId(1L); // TODO: Update ID if necessary
        product.setName("Example Product");
        product.setDescription("Example Description");
        product.setPrice(BigDecimal.valueOf(19.99)); // TODO: Update price as needed
        Product savedProduct = product; // Mock return
        Mockito.when(productRepository.save(product)).thenReturn(savedProduct);
        // Act
        Product result = productController.createProduct(product);
        // Assert
        assertEquals(product.getId(), result.getId());
        assertEquals(product.getName(), result.getName());
        assertEquals(product.getDescription(), result.getDescription());
        assertEquals(product.getPrice(), result.getPrice());
        verify(productRepository).save(product);
    }
