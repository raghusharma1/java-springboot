        Product product2 = new Product(2L, "Product B", null, 200.0); // TODO: Replace with valid sample data
        List<Product> mockedProducts = Arrays.asList(product1, product2);
        when(productRepository.findAll()).thenReturn(mockedProducts);
        // Act
        List<Product> result = productController.getAllProducts();
        // Assert
        assertThat(result).hasSize(2).containsExactly(product1, product2);
    }
    @Test
    @Tag("boundary")
    public void retrieveIdenticalProductsSuccessfully() {
        // Arrange
        Product product = new Product(1L, "Product C", "Description C", 150.0); // TODO: Replace with valid sample data
        List<Product> mockedProducts = Arrays.asList(product, product);
        when(productRepository.findAll()).thenReturn(mockedProducts);
        // Act
        List<Product> result = productController.getAllProducts();
        // Assert
        assertThat(result).hasSize(2).containsExactly(product, product);
    }
    @Test
    @Tag("invalid")
