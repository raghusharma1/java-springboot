        // Arrange
        when(productRepository.findAll()).thenThrow(new RuntimeException("Repository failure")); // TODO: Replace with valid exception message
        // Act & Assert
        assertThatThrownBy(() -> productController.getAllProducts())
                .isInstanceOf(RuntimeException.class)
                .hasMessageContaining("Repository failure");
    }
    @Test
    @Tag("boundary")
    public void retrieveProductsWithNullFieldsSuccessfully() {
        // Arrange
