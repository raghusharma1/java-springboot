package com.bootexample4.products.controller;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.junit.jupiter.MockitoExtension;
import org.mockito.Mock;
import org.mockito.Mockito;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.BDDMockito.*;
import org.junit.jupiter.api.Tag;
import java.util.List;
import java.util.ArrayList;
import com.bootexample4.products.model.Product;
import com.bootexample4.products.repository.ProductRepository;
import org.junit.jupiter.api.*;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

@ExtendWith(MockitoExtension.class)
public class ProductControllerGetAllProductsTest {
    @Mock
    private ProductRepository productRepository;
    @Test
    @Tag("valid")
    public void verifySuccessfulProductRetrieval() {
        // Arrange
        List<Product> mockProducts = new ArrayList<>();
        mockProducts.add(new Product());
        mockProducts.add(new Product());
        given(productRepository.findAll()).willReturn(mockProducts);
        ProductController controller = new ProductController(productRepository);
        // Act
        List<Product> products = controller.getAllProducts();
        // Assert
        assertEquals(mockProducts, products);
    }
    @Test
    @Tag("valid")
    public void verifyEmptyListOnNoProducts() {
        // Arrange
        given(productRepository.findAll()).willReturn(new ArrayList<>());
        ProductController controller = new ProductController(productRepository);
        // Act
        List<Product> products = controller.getAllProducts();
        // Assert
        assertTrue(products.isEmpty());
    }
    @Test
    @Tag("invalid")
    public void verifyExceptionHandling() {
        // Arrange
        given(productRepository.findAll()).willThrow(RuntimeException.class);
        ProductController controller = new ProductController(productRepository);
        // Act and Assert
        assertThrows(RuntimeException.class, controller::getAllProducts);
    }
    @Test
    @Tag("boundary")
    public void verifyResponseStructureAndContentType() {
        // Arrange
        List<Product> mockProducts = new ArrayList<>();
        mockProducts.add(new Product());
        given(productRepository.findAll()).willReturn(mockProducts);
        ProductController controller = new ProductController(productRepository);
        // Act
        List<Product> products = controller.getAllProducts();
        // Assert
        assertNotNull(products);
        assertFalse(products.isEmpty());
        assertTrue(products.get(0) instanceof Product);
    }
}