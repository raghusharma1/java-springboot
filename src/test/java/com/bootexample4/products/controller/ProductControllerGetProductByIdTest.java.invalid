package com.bootexample4.products.controller;
import static org.mockito.Mockito.when;
import static org.assertj.core.api.Assertions.assertThat;
import java.util.Optional;
import com.bootexample4.products.model.Product;
import com.bootexample4.products.repository.ProductRepository;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.springframework.http.ResponseEntity;
import org.junit.jupiter.api.*;
import java.util.List;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.*;

class ProductControllerGetProductByIdTest {
    @Mock
    private ProductRepository productRepository;
    private ProductController productController;
    @BeforeEach
    void setUp() {
        MockitoAnnotations.openMocks(this);
        productController = new ProductController(productRepository);
    }
    @Test
    @Tag("valid")
    public void getProductByIdWhenProductExists() {
        Long existingId = 1L; // TODO: Replace with valid existing ID
        Product mockProduct = new Product(1L, "Test Product", "Test Description", 99.99);
        when(productRepository.findById(existingId)).thenReturn(Optional.of(mockProduct));
        ResponseEntity<Product> response = productController.getProductById(existingId);
        assertThat(response.getStatusCodeValue()).isEqualTo(200);
        assertThat(response.getBody()).isEqualTo(mockProduct);
    }
    @Test
    @Tag("invalid")
    public void getProductByIdWhenProductDoesNotExist() {
        Long nonExistingId = 9999L; // TODO: Replace with non-existent ID
        when(productRepository.findById(nonExistingId)).thenReturn(Optional.empty());
        ResponseEntity<Product> response = productController.getProductById(nonExistingId);
        assertThat(response.getStatusCodeValue()).isEqualTo(404);
        assertThat(response.getBody()).isNull();
    }
    @Test
    @Tag("invalid")
    public void getProductByIdWithNullId() {
        Long nullId = null; // Null ID for testing
        
        try {
            productController.getProductById(nullId);
        } catch (NullPointerException e) {
            assertThat(e).isInstanceOf(NullPointerException.class);
        }
    }
    @Test
    @Tag("invalid")
    public void getProductByIdWithNegativeId() {
        Long negativeId = -1L; // Negative ID for testing
        when(productRepository.findById(negativeId)).thenReturn(Optional.empty());
        ResponseEntity<Product> response = productController.getProductById(negativeId);
        assertThat(response.getStatusCodeValue()).isEqualTo(404);
        assertThat(response.getBody()).isNull();
    }
    @Test
    @Tag("integration")
    public void getProductByIdWhenRepositoryUnavailable() {
        Long validId = 1L; // TODO: Replace with valid existing ID
        when(productRepository.findById(validId)).thenThrow(new RuntimeException("Repository Unavailable"));
        try {
            productController.getProductById(validId);
        } catch (RuntimeException e) {
            assertThat(e).isInstanceOf(RuntimeException.class);
            assertThat(e.getMessage()).isEqualTo("Repository Unavailable");
        }
    }
    @Test
    @Tag("boundary")
    public void getProductByIdWithLargeIdValue() {
        Long largeId = Long.MAX_VALUE; // Large value for testing
        when(productRepository.findById(largeId)).thenReturn(Optional.empty());
        ResponseEntity<Product> response = productController.getProductById(largeId);
        assertThat(response.getStatusCodeValue()).isEqualTo(404);
        assertThat(response.getBody()).isNull();
    }
    @Test
    @Tag("valid")
    public void getProductByIdMultipleTimes() {
        Long existingId = 1L; // TODO: Replace with valid existing ID
        Product mockProduct = new Product(1L, "Test Product", "Test Description", 99.99);
        when(productRepository.findById(existingId)).thenReturn(Optional.of(mockProduct));
        ResponseEntity<Product> response1 = productController.getProductById(existingId);
        ResponseEntity<Product> response2 = productController.getProductById(existingId);
        assertThat(response1.getStatusCodeValue()).isEqualTo(200);
        assertThat(response2.getStatusCodeValue()).isEqualTo(200);
        assertThat(response1.getBody()).isEqualTo(mockProduct);
        assertThat(response2.getBody()).isEqualTo(mockProduct);
    }
}